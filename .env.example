# Copy this file to .env and fill in the real values.
# .env is ignored by git.

# PostgreSQL connection string used by the app and LangGraph's checkpointer.
# Matches docker-compose.yaml for local development.
DATABASE_URL=postgresql://agentic:local-dev-password@localhost:5432/agentic_chatbot

# Google Gemini API key. Create one in Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional connection pool sizes. Defaults are 1 and 10.
# Each uvicorn worker creates its own pool, so the total number of database
# connections is workers x DB_POOL_MAX_SIZE. Keep that below PostgreSQL's
# max_connections (default 100).
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
